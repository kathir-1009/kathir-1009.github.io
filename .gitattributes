# Normalise line endings: check text files in as LF in the repo,
# but check them out with the platform's native endings.
* text=auto

*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.svg    text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf
*.json   text eol=lf

# Never mangle binaries
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.woff   binary
*.woff2  binary
